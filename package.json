{
  "name": "poseforge",
  "version": "0.1.0",
  "description": "Local-first AI photo studio: give it a character and a pose reference, get the character back in that pose. Built for family photoshoots and Instagram-ready posts.",
  "private": true,
  "main": "server.js",
  "license": "Apache-2.0",
  "author": "Vishwa Kulkarni",
  "homepage": "https://github.com/yourusername/poseforge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yourusername/poseforge.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/poseforge/issues"
  },
  "keywords": [
    "ai",
    "image-generation",
    "photo-editing",
    "family-photos",
    "local-first",
    "express",
    "postgresql",
    "codex-cli"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "LOG_LEVEL=debug NODE_ENV=development node --watch server.js",
    "dev:web": "npm --prefix web run dev",
    "dev:all": "concurrently -n api,web -c blue,magenta \"npm:dev\" \"npm:dev:web\"",
    "build:web": "npm --prefix web run build",
    "start:all": "concurrently -n api,web -c blue,magenta \"npm:start\" \"npm --prefix web run start\"",
    "install:all": "npm install && npm --prefix web install",
    "migrate": "node db/migrate.js",
    "generate:mascot": "node scripts/generate-mascot.js",
    "test": "node --test tests/*.test.js",
    "test:web": "npm --prefix web test",
    "test:e2e": "npm --prefix web run test:e2e",
    "test:all": "npm test && npm run test:web",
    "check": "find . -name '*.js' -not -path './node_modules/*' -not -path './storage/*' -not -path './tmp/*' -not -path './web/*' -print0 | xargs -0 -n1 node --check"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "heic-convert": "^2.1.0",
    "multer": "^2.0.1",
    "pg": "^8.22.0",
    "sharp": "^0.35.3"
  }
}
