# Copy this file to .env and adjust as needed.

# Port the local server listens on.
PORT=3004

# Local PostgreSQL connection string.
# The included docker-compose.yml provisions a matching database if you
# don't already have Postgres running locally.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/poseforge

# Optional — override the Codex CLI binary name/path if it's not "codex" on your PATH.
# CODEX_BIN=codex

# Optional — how long (ms) to wait for a Codex CLI generation before timing out.
# CODEX_TIMEOUT_MS=300000

# Optional — how long (ms) to wait for a Replicate generation before timing out.
# REPLICATE_TIMEOUT_MS=300000

# Note: OpenAI and Replicate API keys are NOT set here. Configure them from
# the running app's Settings screen — they're stored in the local database,
# not in environment variables. See SECURITY.md for why.
