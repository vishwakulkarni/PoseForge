# Environment
.env
.env.local

# Dependencies
node_modules/

# Runtime data (uploaded photos, generated results, DB-adjacent scratch files).
# Curated starter poses are application assets and must ship with fresh clones;
# runtime pose uploads/caches remain ignored beside them.
storage/*
!storage/pose-library/
storage/pose-library/*
!storage/pose-library/seed/
!storage/pose-library/seed/**
library/
data/
tmp/

# Editor / OS
.DS_Store
*.log

# Local agent/tool config — not part of the published project
.claude/

# Leftover from broken git init attempts during scaffolding — safe to delete
.git-broken-do-not-use/
.git-attempt1-do-not-use/
