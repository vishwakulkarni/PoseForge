# Copy this file to .env and adjust as needed.

# Port the single local server listens on.
PORT=3000

# Embedded PGlite is the default and needs no database server.
DATABASE_MODE=pglite
PGLITE_DATA_DIR=storage/pglite

# To use an existing PostgreSQL server instead, switch the mode and uncomment
# its connection string.
# DATABASE_MODE=postgres
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/poseforge

# Optional — override the Codex CLI binary name/path if it's not "codex" on your PATH.
# CODEX_BIN=codex

# Optional — how long (ms) to wait for a Codex CLI generation before timing out.
# CODEX_TIMEOUT_MS=300000

# Optional — Google Antigravity CLI binary, model, and generation timeout.
# ANTIGRAVITY_BIN=agy
# ANTIGRAVITY_MODEL=gemini-3.6-flash-high
# ANTIGRAVITY_TIMEOUT_MS=600000

# Optional — how long (ms) to wait for a Replicate generation before timing out.
# REPLICATE_TIMEOUT_MS=300000

# Optional — Gemini can also be configured in Settings.
# GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview

# Optional — fal.ai can also be configured in Settings.
# FAL_KEY=
# FAL_TIMEOUT_MS=600000

# Optional — local ComfyUI connection. The workflow may instead be pasted in Settings.
# COMFYUI_URL=http://127.0.0.1:8188
# COMFYUI_MODEL=flux2-klein-4b
# COMFYUI_WORKFLOW_PATH=/absolute/path/to/poseforge-api-workflow.json
# COMFYUI_TIMEOUT_MS=600000
# Keep remote ComfyUI disabled unless you operate a secured private deployment.
# COMFYUI_ALLOW_REMOTE=false

# OpenAI and Replicate keys can be configured from the running app's Settings
# screen. Database-backed credentials are stored as plain text; prefer
# environment variables where supported and review SECURITY.md.
